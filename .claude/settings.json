      "Bash(node scripts/check-complexity-gym.mjs:*)",
      "Bash(node scripts/check-plc-st.mjs:*)",
      "Bash(node scripts/verify-solutions.mjs:*)",
      "Bash(node scripts/check-overflow.mjs:*)",
      "Bash(node scripts/check-site.mjs:*)",
      "Bash(node scripts/export-content.mjs:*)",
      "Bash(node client/scripts/check-glossary.mjs:*)",
      "Bash(node client/scripts/check-complexity-gym.mjs:*)",
      "Bash(node client/scripts/check-plc-st.mjs:*)",
      "Bash(node client/scripts/verify-solutions.mjs:*)",
